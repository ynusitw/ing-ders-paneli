rules_version = '2';

// Uygulamanın verisi API route'ları (Admin SDK, bu kurallardan etkilenmez)
// üzerinden okunup yazılıyor. İstemci (tarayıcı) Firestore'a doğrudan sadece
// video odası sinyalleşmesi için erişir; bu yüzden varsayılan her şeyi kapatıp
// sadece rooms/{roomId} ve trickle ICE adaylarının yazıldığı alt koleksiyonları,
// dersin gerçek katılımcılarına açıyoruz.
service cloud.firestore {
  match /databases/{database}/documents {
    function isRoomParticipant(roomId) {
      let lesson = get(/databases/$(database)/documents/lessons/$(roomId)).data;
      return request.auth != null &&
        exists(/databases/$(database)/documents/lessons/$(roomId)) &&
        (lesson.teacherId == request.auth.uid || lesson.studentId == request.auth.uid);
    }

    match /rooms/{roomId} {
      allow read, write: if isRoomParticipant(roomId);

      match /callerCandidates/{candidateId} {
        allow read, write: if isRoomParticipant(roomId);
      }
      match /calleeCandidates/{candidateId} {
        allow read, write: if isRoomParticipant(roomId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
